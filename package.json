{
  "author": "",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@taplo/cli": "^0.7.0",
    "@tombi-toml/cli": "^1.9.8",
    "markdownlint-cli2": "^0.24.0",
    "npm-run-all2": "^9.0.4"
  },
  "engines": {
    "npm": "Use pnpm instead of npm!"
  },
  "license": "",
  "main": "",
  "name": "garoh",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "run-p format:biome format:markdownlint format:toml",
    "format:biome": "biome check --write",
    "format:markdownlint": "markdownlint-cli2 --fix \"*.md\" \"doc/*.md\"",
    "format:toml": "taplo format *.toml",
    "test": ":",
    "lint": "run-p lint:biome lint:md lint:toml",
    "lint:biome": "biome check",
    "lint:md": "markdownlint-cli2 \"*.md\"",
    "lint:toml": "taplo format --check *.toml"
  },
  "version": "1.0.0",
  "packageManager": "pnpm@12.16.1"
}
